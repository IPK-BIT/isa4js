{
  "name": "isa4js",
  "version": "0.1.3",
  "description": "Transform ISA-JSON to ISA-Tab format",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "change": "changeset",
    "version-packages": "changeset version",
    "release:tag": "changeset tag",
    "release": "changeset publish",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "tsx scripts/generate-types.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ipk-bit/isa4js"
  },
  "homepage": "https://ipk-bit.github.io/isa4js",
  "bugs": {
    "url": "https://github.com/IPK-BIT/isa4js/issues/new/choose"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "ISA",
    "conversion",
    "ISA-JSON",
    "ISA-Tab"
  ],
  "author": "Manuel Feser <feser@ipk-gatersleben.de> (https://github.com/feserm)",
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.1",
      "onFail": "warn"
    }
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
